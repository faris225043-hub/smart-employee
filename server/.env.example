# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (Atlas or compatible MongoDB URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_ems?retryWrites=true&w=majority
MONGODB_URI=

# Frontend Application Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Authentication / Session Secrets
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=1d
